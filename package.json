{
  "name": "file-manager",
  "version": "1.0.0",
  "description": "Лёгкий веб-файлообменник: загрузка и скачивание напрямую в S3 через presigned URLs",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --max-old-space-size=96 --max-semi-space-size=2 src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i frontend/tailwind.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i frontend/tailwind.css -o public/css/app.css --watch",
    "hash-password": "node scripts/hash-password.js",
    "s3:cors": "node scripts/apply-cors.js",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
