# ===== Приложение =====
# Публичный адрес сайта (без слеша в конце). Используется для CSRF-проверки и CORS.
APP_ORIGIN=https://files.example.com
# Слушаем только localhost — наружу приложение отдаёт Nginx.
HOST=127.0.0.1
PORT=3000
# Сколько прокси стоит перед Node.js (Nginx FastPanel = 1).
TRUST_PROXY=1

# ===== Доступ =====
# Сгенерируйте: npm run hash-password  (значение в одинарных кавычках!)
ADMIN_PASSWORD_HASH='scrypt$16384$8$1$...$...'
# Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ===== S3-хранилище =====
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=my-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
# true — https://endpoint/bucket/key (подходит почти всем S3-совместимым),
# false — https://bucket.endpoint/key
S3_FORCE_PATH_STYLE=true
# Папка внутри бакета, в которой хранятся файлы
S3_PREFIX=uploads/

# ===== Лимиты =====
MAX_FILE_SIZE_MB=5120
# Файлы крупнее порога грузятся частями (multipart)
MULTIPART_THRESHOLD_MB=64
MULTIPART_PART_SIZE_MB=16
# Срок жизни ссылки на загрузку
UPLOAD_URL_TTL_MIN=60
