# Минимальный .env — достаточно двух строк: APP_ORIGIN и ADMIN_PASSWORD_HASH.
# Всё остальное (кроме DATA_DIR и ADMIN_*) можно задать и менять в интерфейсе:
# Настройки → Хранилища / Загрузка файлов / Сайт и безопасность.
# Значения отсюда служат значениями по умолчанию; изменения из интерфейса
# сохраняются в data/settings.json и имеют приоритет.

# ===== Обязательно =====
# Публичный адрес сайта (без слеша в конце). Используется для CSRF-проверки и CORS.
APP_ORIGIN=https://files.example.com
# Первый администратор (создаётся при первом запуске). Хеш: npm run hash-password
# Значение — в одинарных кавычках!
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='scrypt$16384$8$1$...$...'

# ===== Только в .env =====
# Каталог данных: users.json и settings.json (по умолчанию ./data).
# DATA_DIR=data

# ===== Необязательно (можно задать в интерфейсе) =====
# Слушаем только localhost — наружу приложение отдаёт Nginx. HOST/PORT — после перезапуска.
# HOST=127.0.0.1
# PORT=3000
# Сколько прокси стоит перед Node.js (Nginx FastPanel = 1).
# TRUST_PROXY=1
# Если не задан — сгенерируется автоматически и сохранится в data/settings.json.
# SESSION_SECRET=
# SESSION_TTL_HOURS=12

# S3-хранилища удобнее подключать в интерфейсе (Настройки → Хранилища): их может быть
# несколько — они объединяются в один диск; есть готовые настройки для Yandex, Cloud.ru,
# Selectel, Timeweb, VK Cloud, Cloudflare R2, Amazon S3, MinIO и проверка подключения.
# Переменные ниже, если заданы, используются ТОЛЬКО при первом запуске — из них
# создаётся первое хранилище «Основное».
# S3_ENDPOINT=https://s3.cloud.ru
# S3_REGION=ru-central-1
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# true — https://endpoint/bucket/key (подходит почти всем S3-совместимым),
# false — https://bucket.endpoint/key
# S3_FORCE_PATH_STYLE=true
# Папка внутри бакета, в которой хранятся файлы
# S3_PREFIX=uploads/

# Лимиты загрузки
# MAX_FILE_SIZE_MB=5120
# MULTIPART_THRESHOLD_MB=64
# MULTIPART_PART_SIZE_MB=16
# UPLOAD_URL_TTL_MIN=60
# Сколько дней удалённое лежит в корзине (0 — удалять сразу)
# TRASH_DAYS=30

# Личные папки «<PERSONAL_ROOT>/<логин>/» — видит только владелец и администраторы
# PERSONAL_FOLDERS=false
# PERSONAL_ROOT=Личные

# Вход через Яндекс ID / Google (входят только пользователи с указанной у них почтой).
# Redirect URI: <APP_ORIGIN>/api/auth/oauth/yandex/callback и …/google/callback
# OAUTH_YANDEX_ID=
# OAUTH_YANDEX_SECRET=
# OAUTH_GOOGLE_ID=
# OAUTH_GOOGLE_SECRET=
