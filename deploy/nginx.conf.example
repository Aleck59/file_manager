# Фрагмент для FastPanel: «Сайты» → ваш сайт → «Конфигурация» → Nginx.
# Замените содержимое блока `location /` (и уберите проксирование на Apache/PHP, если оно есть)
# на этот блок. Остальное (listen, ssl_certificate, server_name) оставьте как сгенерировал FastPanel.

location / {
    proxy_pass         http://127.0.0.1:3000;
    proxy_http_version 1.1;

    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   Connection        "";

    proxy_connect_timeout 5s;
    proxy_read_timeout    60s;
    proxy_send_timeout    60s;

    # Файлы идут напрямую в S3, через Nginx проходит только JSON — тело запроса маленькое.
    client_max_body_size 64k;
}

# Статику отдаёт сам Nginx — меньше работы для Node.js.
# Путь замените на свой (FastPanel: /var/www/<пользователь>/data/www/<домен>/public).
location ~ ^/(css|js)/ {
    root /var/www/USER/data/www/files.example.com/public;
    expires 1h;
    add_header Cache-Control "public";
    access_log off;
}

location = /favicon.svg {
    root /var/www/USER/data/www/files.example.com/public;
    expires 7d;
    access_log off;
}
