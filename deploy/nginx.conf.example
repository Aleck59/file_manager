# Фрагмент для FastPanel: «Сайты» → ваш сайт → «Конфигурация» → Nginx.
#
# (Рекомендуется) Ограничение частоты входа на уровне Nginx — добавьте в блок http {}
# (FastPanel: /etc/nginx/nginx.conf или файл в /etc/nginx/conf.d/):
#   limit_req_zone $binary_remote_addr zone=fm_login:1m rate=10r/m;
# и раскомментируйте location = /api/auth/login ниже.
# Замените содержимое блока `location /` (и уберите проксирование на Apache/PHP, если оно есть)
# на этот блок. Остальное (listen, ssl_certificate, server_name) оставьте как сгенерировал FastPanel.

location / {
    proxy_pass         http://127.0.0.1:3000;
    proxy_http_version 1.1;

    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   Connection        "";

    proxy_connect_timeout 5s;
    # Переименование/перемещение очень больших файлов — это копирование внутри S3,
    # которое может занять несколько минут. Обычные запросы отвечают за доли секунды.
    proxy_read_timeout    300s;
    proxy_send_timeout    60s;

    # Файлы идут напрямую в S3, через Nginx проходит только JSON — тело запроса маленькое.
    client_max_body_size 64k;
}

# WebDAV (если включён в настройках): файлы идут через сервер, поэтому здесь большое тело
# запроса и без буферизации — загрузка сразу потоком уходит в S3.
location /dav/ {
    proxy_pass         http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_set_header   Connection        "";
    proxy_request_buffering off;
    proxy_buffering         off;
    client_max_body_size    0;      # предел задаёт приложение (MAX_FILE_SIZE_MB)
    proxy_read_timeout      3600s;
    proxy_send_timeout      3600s;
}

